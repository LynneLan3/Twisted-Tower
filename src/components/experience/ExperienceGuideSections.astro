---
/**
 * ExperienceGuideSections — editorial bottom sections for Guide content pages.
 * Rendered after the Markdown body on Experience guides:
 * evidence, source record, next questions, more references, route context,
 * and other routes.
 */
import GuideEvidence from '../GuideEvidence.astro';
import SourceList from '../SourceList.astro';
import PageRouteContext from './routes/PageRouteContext.astro';
import { ui } from '../../lib/ui';
import { experienceNav } from '../../lib/experience-nav';
import { guideHref } from '../../lib/guides';
import { loadGuideContent } from '../../lib/guide-content';

const { entry } = Astro.locals.starlightRoute;
const t = ui();
const { guidesHref } = experienceNav();
const content = await loadGuideContent(entry);
const data = entry.data;
---

{/* Evidence — content width when present */}
{((data.evidence ?? []).length > 0) && (
	<div class="exp-guide-evidence-wrap exp-guide-sections-block">
		<GuideEvidence />
	</div>
)}

{/* Source record — reading width when present */}
{((data.sources ?? []).length > 0) && (
	<div class="exp-guide-sources-wrap exp-guide-sections-block">
		<SourceList />
	</div>
)}

{/* Next Questions — from relations[type=next-step], max 3 */}
{content.nextGuides.length > 0 && (
	<div class="exp-guide-next-wrap exp-guide-sections-block">
		<section class="exp-guide-next" aria-labelledby="exp-guide-next-heading">
			<p class="exp-eyebrow">{t.nextQuestions}</p>
			<h2 class="exp-guide-next__heading" id="exp-guide-next-heading">{t.nextQuestionsLede}</h2>
			<div class="exp-guide-next__list">
				{content.nextGuides.map((guide, index) => (
					<a class="exp-guide-next__item" href={guideHref(guide)}>
						<span class="exp-number exp-number--sm exp-guide-next__number">
							{String(index + 1).padStart(2, '0')}
						</span>
						<div class="exp-guide-next__body">
							<span class="exp-guide-next__title">{guide.data.title}</span>
							{guide.data.description && (
								<span class="exp-guide-next__desc">{guide.data.description}</span>
							)}
						</div>
						<span class="exp-guide-next__arrow" aria-hidden="true">→</span>
					</a>
				))}
			</div>
		</section>
	</div>
)}

{/* More References — weak, only guides not already surfaced as next steps */}
{content.related.length > 0 && (
	<div class="exp-guide-references-wrap exp-guide-sections-block">
		<nav class="exp-guide-references" aria-labelledby="exp-guide-references-heading">
			<p class="exp-eyebrow" id="exp-guide-references-heading">{t.moreReferences}</p>
			<ul class="exp-guide-references__list">
				{content.related.map((guide) => (
					<li>
						<a href={guideHref(guide)}>{guide.data.title}</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
)}

{/* Route context — all routes this guide belongs to */}
{content.currentRoutes.length > 0 && (
	<div class="exp-guide-route-wrap exp-guide-sections-block">
		<PageRouteContext pageId={content.pageId} routes={content.routes} guidesHref={guidesHref} />
	</div>
)}

{/* Other Routes — weak, derived from runtime config, max 3 */}
{content.otherRoutes.length > 0 && (
	<div class="exp-guide-other-wrap exp-guide-sections-block">
		<nav class="exp-guide-other-routes" aria-label={t.exploreAnotherRoute}>
			<p class="exp-eyebrow">{t.exploreAnotherRoute}</p>
			<div class="exp-other-routes">
				{content.otherRoutes.map((route) => {
					const number = String(content.routes.indexOf(route) + 1).padStart(2, '0');
					return (
						<a class="exp-other-route" href={route.href}>
							<span class="exp-number exp-number--xs exp-other-route__number">{number}</span>
							<span class="exp-other-route__label">{route.title}</span>
						</a>
					);
				})}
			</div>
		</nav>
	</div>
)}
