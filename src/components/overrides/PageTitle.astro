---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import GuideBreadcrumb from '../GuideBreadcrumb.astro';
import GuideStatus from '../GuideStatus.astro';
import QuickAnswer from '../QuickAnswer.astro';
import GuideHero from '../GuideHero.astro';
import GuideFacts from '../GuideFacts.astro';
import ExperienceGuideHeader from '../experience/ExperienceGuideHeader.astro';
import { isCategoryLandingPath } from '../../lib/guides';
import { isTrustPath } from '../../lib/trust';
import { isExperienceGuide } from '../../lib/experience-guide';
import { formatUiDate, ui } from '../../lib/ui';

const { entry } = Astro.locals.starlightRoute;
const t = ui();
const isSplash = entry.data.template === 'splash';
const isCategoryLanding = isCategoryLandingPath(Astro.url.pathname);
const isTrust = isTrustPath(Astro.url.pathname);
const isExperience = isExperienceGuide(entry, Astro.url.pathname);
const isArticle = !isSplash && !isCategoryLanding && !isTrust;
const lastUpdated = entry.data.lastUpdated instanceof Date ? entry.data.lastUpdated : undefined;
const eyebrow: string | undefined = (entry.data as Record<string, unknown>).eyebrow as string | undefined;
---

{isExperience && <ExperienceGuideHeader />}

{
	isArticle && !isExperience && (
		<>
			<GuideBreadcrumb />
			{eyebrow && <p class="gw-eyebrow">{eyebrow}</p>}
		</>
	)
}

{!isSplash && !isExperience && (
	<Default>
		<slot />
	</Default>
)}

{
	isArticle && !isExperience && entry.data.description && (
		<p class="gw-guide-dek">{entry.data.description}</p>
	)
}

{
	isArticle && !isExperience && (
		<>
			<div class="gw-article-meta">
				{entry.data.status && <GuideStatus status={entry.data.status} />}
				{lastUpdated && (
					<time datetime={lastUpdated.toISOString()}>
						{t.updatedOn(formatUiDate(lastUpdated))}
					</time>
				)}
			</div>
			<GuideHero />
			<GuideFacts />
			{entry.data.quickAnswer && <QuickAnswer text={entry.data.quickAnswer} />}
		</>
	)
}
